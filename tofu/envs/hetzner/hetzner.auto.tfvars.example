# Copier en hetzner.auto.tfvars (ignoré par Git). Secrets uniquement par TF_VAR_* :
#   phrase de chiffrement de l'état, jeton Hetzner Cloud, clé Tailscale,
#   identifiants S3 Hetzner (voir variables.tf : variables TF_VAR_* correspondantes).
cluster_name                = "platform"
location                    = "fsn1"
server_type                 = "cx33"
node_count                  = 1
bucket_prefix               = "CHANGE_ME"
tailscale_magicdns_domain   = "CHANGE_ME.ts.net"
github_app_id               = 0000000
github_app_installation_id  = 00000000
github_app_private_key_file = "~/.config/platform/github-app-platform-flux.pem"
ghcr_username               = "clemuscle"
